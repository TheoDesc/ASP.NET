@model StudentManager.Models.Entities.Student

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<input type="hidden" asp-for="Id" />

<div class="mb-3">
    <label asp-for="Name" class="form-label"></label>
    <div class="input-group">
        <span class="input-group-text"><i class="bi bi-person"></i></span>
        <input asp-for="Name" class="form-control" placeholder="Ex : Jean Dupont" />
    </div>
    <span asp-validation-for="Name" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Email" class="form-label"></label>
    <div class="input-group">
        <span class="input-group-text"><i class="bi bi-envelope"></i></span>
        <input asp-for="Email" class="form-control" placeholder="jean.dupont@exemple.fr" />
    </div>
    <span asp-validation-for="Email" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Phone" class="form-label"></label>
    <div class="input-group">
        <span class="input-group-text"><i class="bi bi-telephone"></i></span>
        <input asp-for="Phone" class="form-control" placeholder="06 12 34 56 78" />
    </div>
    <span asp-validation-for="Phone" class="text-danger"></span>
</div>

<div class="form-check form-switch switch-card mb-4">
    <input asp-for="Subscribed" class="form-check-input" role="switch" />
    <label asp-for="Subscribed" class="form-check-label fw-semibold"></label>
    <div class="form-text">L'étudiant reçoit les actualités et communications.</div>
</div>
