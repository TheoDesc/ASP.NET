@{
    ViewData["Title"] = "Accueil";
    var fullName = ViewData["FullName"] as string;
}

<section class="hero fade-up">
    <span class="hero-badge"><i class="bi bi-stars"></i> Gestion simple et rapide</span>
    <h1>Bienvenue@(string.IsNullOrWhiteSpace(fullName) ? "" : " " + fullName)</h1>
    <p>Ajoutez, modifiez et retrouvez vos étudiants en quelques clics, dans une interface claire et rapide.</p>
    <div class="d-flex flex-wrap justify-content-center gap-3">
        <a asp-controller="Students" asp-action="Index" class="btn btn-light btn-lg">
            <i class="bi bi-people me-2"></i>Voir les étudiants
        </a>
        <a asp-controller="Students" asp-action="Create" class="btn btn-outline-light btn-lg">
            <i class="bi bi-plus-lg me-2"></i>Ajouter un étudiant
        </a>
    </div>
</section>

<div class="row g-4 mt-2">
    <div class="col-md-4 fade-up delay-1">
        <div class="app-card feature">
            <span class="icon-bubble"><i class="bi bi-ui-checks-grid"></i></span>
            <h5>CRUD complet</h5>
            <p>Créer, lire, modifier et supprimer, avec une confirmation avant chaque suppression.</p>
        </div>
    </div>
    <div class="col-md-4 fade-up delay-2">
        <div class="app-card feature">
            <span class="icon-bubble"><i class="bi bi-database"></i></span>
            <h5>Données persistantes</h5>
            <p>Tout est stocké dans une base SQLite grâce à Entity Framework Core.</p>
        </div>
    </div>
    <div class="col-md-4 fade-up delay-3">
        <div class="app-card feature">
            <span class="icon-bubble"><i class="bi bi-shield-lock"></i></span>
            <h5>Accès sécurisé</h5>
            <p>Seuls les utilisateurs connectés accèdent à l'application, grâce à ASP.NET Core Identity.</p>
        </div>
    </div>
</div>
