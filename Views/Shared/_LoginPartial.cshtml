@using Microsoft.AspNetCore.Identity
@using StudentManager.Models.Entities
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@{
    string displayName = User.Identity?.Name ?? string.Empty;
    string initial = "?";
    var signedIn = SignInManager.IsSignedIn(User);
    var isAdmin = signedIn && User.IsInRole("Admin");

    if (signedIn)
    {
        var currentUser = await UserManager.GetUserAsync(User);
        if (currentUser is not null && !string.IsNullOrWhiteSpace(currentUser.FirstName))
        {
            displayName = currentUser.FirstName;
        }
        if (!string.IsNullOrWhiteSpace(displayName))
        {
            initial = displayName.Substring(0, 1).ToUpperInvariant();
        }
    }
}

@if (signedIn)
{
    @if (isAdmin)
    {
        <a class="btn btn-ghost btn-sm" asp-controller="Users" asp-action="Index">
            <i class="bi bi-person-gear me-1"></i>Utilisateurs
        </a>
    }
    <div class="user-pill">
        <span class="avatar avatar-sm avatar-0">@initial</span>
        <span class="d-none d-sm-inline">@displayName</span>
        @if (isAdmin)
        {
            <span class="badge text-bg-primary">Admin</span>
        }
    </div>
    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
        <button type="submit" class="btn btn-ghost btn-sm">
            <i class="bi bi-box-arrow-right me-1"></i>Déconnexion
        </button>
    </form>
}
else
{
    <a class="btn btn-ghost btn-sm" asp-controller="Account" asp-action="Login">Connexion</a>
    <a class="btn btn-brand btn-sm" asp-controller="Account" asp-action="Register">Inscription</a>
}
